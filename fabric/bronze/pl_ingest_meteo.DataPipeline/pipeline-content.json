{
  "properties": {
    "activities": [
      {
        "type": "Lookup",
        "typeProperties": {
          "source": {
            "type": "LakehouseTableSource"
          },
          "datasetSettings": {
            "type": "LakehouseTable",
            "typeProperties": {
              "schema": "dbo",
              "table": "ref_regions"
            },
            "schema": [],
            "connectionSettings": {
              "name": "lh_bronze",
              "properties": {
                "type": "Lakehouse",
                "typeProperties": {
                  "artifactId": "6bbb5daf-3cb5-8e22-48e7-b6fb5cfb5a02",
                  "workspaceId": "00000000-0000-0000-0000-000000000000",
                  "rootFolder": "Tables"
                },
                "externalReferences": {
                  "connection": "daa0b8a2-b67f-4180-b531-ddb8c21d7710"
                },
                "annotations": []
              }
            },
            "annotations": []
          },
          "firstRowOnly": false
        },
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureInput": false,
          "secureOutput": false
        },
        "name": "Lookup ref_regions",
        "dependsOn": [
          {
            "activity": "Set variables date_fin",
            "dependencyConditions": [
              "Succeeded"
            ]
          },
          {
            "activity": "Set variables date_debut",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
      {
        "type": "ForEach",
        "typeProperties": {
          "isSequential": true,
          "items": {
            "value": "@activity('Filter1').output.value",
            "type": "Expression"
          },
          "activities": [
            {
              "type": "Copy",
              "typeProperties": {
                "source": {
                  "type": "BinarySource",
                  "formatSettings": {
                    "type": "BinaryReadSettings"
                  },
                  "storeSettings": {
                    "type": "HttpReadSettings",
                    "requestMethod": "GET"
                  },
                  "datasetSettings": {
                    "type": "Binary",
                    "typeProperties": {
                      "location": {
                        "type": "HttpServerLocation",
                        "relativeUrl": {
                          "value": "v1/archive?latitude=@{item().latitude}&longitude=@{item().longitude}&start_date=@{variables('v_date_debut')}&end_date=@{variables('v_date_fin')}&hourly=temperature_2m,wind_speed_10m,shortwave_radiation&timezone=UTC",
                          "type": "Expression"
                        }
                      }
                    },
                    "externalReferences": {
                      "connection": "a4f37421-c13f-41a5-bcf4-068543d4e01e"
                    },
                    "annotations": []
                  }
                },
                "sink": {
                  "type": "BinarySink",
                  "storeSettings": {
                    "type": "AzureBlobStorageWriteSettings"
                  },
                  "datasetSettings": {
                    "type": "Binary",
                    "typeProperties": {
                      "location": {
                        "type": "LakehouseLocation",
                        "folderPath": {
                          "value": "meteo/archive/region=@{item().code_insee_region}/annee=@{pipeline().parameters.annee}",
                          "type": "Expression"
                        },
                        "fileName": "meteo.json"
                      }
                    },
                    "connectionSettings": {
                      "name": "lh_bronze",
                      "properties": {
                        "type": "Lakehouse",
                        "typeProperties": {
                          "artifactId": "6bbb5daf-3cb5-8e22-48e7-b6fb5cfb5a02",
                          "workspaceId": "00000000-0000-0000-0000-000000000000",
                          "rootFolder": "Files"
                        },
                        "externalReferences": {
                          "connection": "daa0b8a2-b67f-4180-b531-ddb8c21d7710"
                        },
                        "annotations": []
                      }
                    },
                    "annotations": []
                  }
                },
                "enableStaging": false
              },
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 3,
                "retryIntervalInSeconds": 60,
                "secureInput": false,
                "secureOutput": false
              },
              "name": "Copy_meteo_region",
              "dependsOn": []
            },
            {
              "type": "Wait",
              "typeProperties": {
                "waitTimeInSeconds": 5
              },
              "name": "Wait_quota",
              "dependsOn": [
                {
                  "activity": "Copy_meteo_region",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ]
            }
          ]
        },
        "name": "ForEach regions",
        "dependsOn": [
          {
            "activity": "Filter1",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
      {
        "type": "SetVariable",
        "typeProperties": {
          "variableName": "v_date_fin",
          "value": {
            "value": "@if(equals(pipeline().parameters.annee,\n    int(formatDateTime(addDays(utcNow(), -6), 'yyyy'))),\n    formatDateTime(addDays(utcNow(), -6), 'yyyy-MM-dd'),\n    concat(string(pipeline().parameters.annee), '-12-31'))",
            "type": "Expression"
          }
        },
        "policy": {
          "secureInput": false,
          "secureOutput": false
        },
        "name": "Set variables date_fin",
        "dependsOn": []
      },
      {
        "type": "Filter",
        "typeProperties": {
          "items": {
            "value": "@activity('Lookup ref_regions').output.value",
            "type": "Expression"
          },
          "condition": {
            "value": "@equals(item().perimetre_eco2mix, true )",
            "type": "Expression"
          }
        },
        "name": "Filter1",
        "dependsOn": [
          {
            "activity": "Lookup ref_regions",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
      {
        "type": "SetVariable",
        "typeProperties": {
          "variableName": "v_date_debut",
          "value": "@concat(string(pipeline().parameters.annee), '-01-01')"
        },
        "policy": {
          "secureInput": false,
          "secureOutput": false
        },
        "name": "Set variables date_debut",
        "dependsOn": []
      }
    ],
    "parameters": {
      "annee": {
        "type": "string",
        "defaultValue": "2021-01-01"
      },
      "parent_run_id": {
        "type": "string"
      }
    },
    "variables": {
      "v_date_fin": {
        "type": "String"
      },
      "v_date_debut": {
        "type": "String"
      }
    }
  }
}