model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: fr-FR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["DirectLake – wh_electricite","DirectLake – lh_gold"]

annotation PBI_ProTooling = ["RemoteModeling","DirectLakeOnOneLakeCreatedInDesktop","DirectLakeOnOneLakeMultisource"]

ref table Filière
ref table Date
ref table Production
ref table Consommation
ref table Acces_region
ref table Région
ref table fact_prevision_conso

ref role lecteur_regional

