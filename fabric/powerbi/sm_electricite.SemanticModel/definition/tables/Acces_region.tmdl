		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'MAPE prévision' = AVERAGEX ( fact_prevision_conso, DIVIDE ( ABS ( [prevision_mwh] - [conso_mwh] ), [conso_mwh] ) )
