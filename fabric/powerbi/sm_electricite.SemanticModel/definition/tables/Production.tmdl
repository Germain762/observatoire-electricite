table Production
	lineageTag: ae7f416d-25de-4bb8-85b2-90b0b4df719f
	sourceLineageTag: [fact].[production_horaire]

	measure 'Production MWh' = SUM ( 'Production'[mwh] )
		formatString: #,0
		displayFolder: Production
		lineageTag: a7a88be8-63a4-47eb-a2c4-160c8912b3b3

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = FormatStringDefinition

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Production TWh' = DIVIDE ( [Production MWh], 1e6 )
		formatString: " #,0.0"
		displayFolder: Production
		lineageTag: e1fd6748-f719-47d2-986d-98abb234644f

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Part filière' = DIVIDE ( [Production MWh], CALCULATE ( [Production MWh], REMOVEFILTERS ( 'Filière' ) ) )
		formatString: " 0.0%"
		displayFolder: Mix
		lineageTag: 8a572c04-426a-4bb7-8977-cb4abc398fe9

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Part bas carbone' =
			DIVIDE (
			    CALCULATE ( [Production MWh], 'Filière'[bas_carbone] = TRUE () ),
			    CALCULATE ( [Production MWh], REMOVEFILTERS ( 'Filière' ) )
			)
		formatString: " 0.0%"
		displayFolder: Mix
		lineageTag: d297dc21-b352-4e7b-894f-6bef777829b9

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Production N-1' = CALCULATE ( [Production MWh], SAMEPERIODLASTYEAR ( 'Date'[date] ) )
		formatString: " #,0"
		displayFolder: Evolution
		lineageTag: cb6d8d9b-e749-4a23-a4d4-c5100478a95c

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Évolution N/N-1' = DIVIDE ( [Production MWh] - [Production N-1], [Production N-1] )
		formatString: " +0.0 %;-0.0 %"
		displayFolder: Evolution
		lineageTag: 777dbfb5-5d05-469a-ada9-e4bf1acb84b2

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Heures incomplètes' = CALCULATE ( COUNTROWS ( 'Production' ), 'Production'[nb_pas] < 2 )
		formatString: #,0
		displayFolder: Qualité
		lineageTag: 1f3ffc67-3140-4b55-a025-33a9ebb159d3

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isCustom":true}

